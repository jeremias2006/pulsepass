# Plantilla de variables de entorno. NO contiene secretos reales. Spring Boot no lee un archivo .env por sí solo:
# define estas variables en tu sistema o en la configuración de ejecución del IDE. El archivo .env real, si lo creas
# como copia local, está en .gitignore y no se sube al repositorio.
#
# Obligatoria: clave secreta de firma de los JWT. "openssl rand -base64 32" genera 32 bytes aleatorios en Base64.
PULSEPASS_JWT_SECRET_BASE64=<genera-con-openssl-rand-base64-32>
# Opcional: emisor de los tokens (por defecto pulsepass-api).
PULSEPASS_JWT_ISSUER=pulsepass-api
# Opcional: orígenes de navegador permitidos (CORS), separados por comas. Vacío = ninguno.
PULSEPASS_CORS_ORIGINS=http://localhost:3000
# Solo perfil "local": contraseñas de las cuentas semilla (mín. 12 caracteres)
PULSEPASS_BOOTSTRAP_ADMIN_PASSWORD=<elige-una-frase-larga>
PULSEPASS_BOOTSTRAP_STAFF_PASSWORD=<elige-otra-frase-larga>